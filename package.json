{
  "name": "justz-studio",
  "productName": "JUSTZ Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Lokale Video-Schnittsoftware von JUSTZ Media Works: Talking Heads in Minuten zu postfertigen Reels.",
  "author": "JUSTZ Media Works",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/anton": "5.2.6",
    "@fontsource/inter": "5.2.8",
    "@fontsource/michroma": "5.2.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "de.justzmediaworks.studio",
    "productName": "JUSTZ Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": ".",
        "to": ".",
        "filter": [
          "logo.png"
        ]
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "logo.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": "justz",
        "name": "JUSTZ-Projekt",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
